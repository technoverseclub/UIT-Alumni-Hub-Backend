generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ALUMNI
}

enum OtpPurpose {
  SIGNUP
  LOGIN
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  role      Role
  createdAt DateTime @default(now())

}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  purpose   OtpPurpose
  isUsed    Boolean   @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

    @@index([email, purpose])
}

