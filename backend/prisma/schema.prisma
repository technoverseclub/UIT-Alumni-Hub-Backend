generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ALUMNI
}

enum OtpPurpose {
  SIGNUP
  LOGIN
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique

  role      Role
  createdAt DateTime @default(now())

  alumniProfile AlumniProfile?
  studentProfile StudentProfile?
}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  purpose   OtpPurpose
  isUsed    Boolean   @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

    @@index([email, purpose])
}

model AlumniProfile {
  id             Int    @id @default(autoincrement())
  userId         Int    @unique

  phone          String
  batch          Int
  branch         String

  graduationYear Int
  company        String
  position       String

  linkedin       String?
  bio            String?
  imageUrl       String?

  user User @relation(fields: [userId], references: [id])
}

model StudentProfile {
  id     Int @id @default(autoincrement())
  userId Int @unique
  branch String
  year   Int

  user User @relation(fields: [userId], references: [id])
}
